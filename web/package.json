    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "6.0.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
