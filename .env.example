# Mono Sweep sandbox only. Production stays blocked until sandbox certification.
MONO_SWEEP_ENABLED=false
PARTIAL_SWEEP_ENABLED=false
AUTOMATIC_COLLECTION_ENABLED=false
AUTOMATIC_RETRY_ENABLED=false
# Set COLLECTION_PROVIDER=mono-sweep when enabling this adapter.
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
MONO_REDIRECT_URL=

# Operational default; confirm the notice period against approved buyer terms before real collections.
# Business policies are seeded once from deployment defaults. Later business changes
# use Admin > Business settings; deployment ceilings and provider approvals still apply.
COLLECTION_NOTICE_MIN_HOURS=24

# How long a delivered goods-release notice must sit with a buyer before silence
# may activate the obligation. Three days, not one: goods released on a Friday
# afternoon must not be deemed accepted before the buyer reopens on Monday.
# Deemed acceptance additionally requires a confirmed notice delivery and is
# never applied to a buyer's first trade credit (README section 8.3.1).
DEEMED_ACCEPTANCE_MIN_HOURS=72

# Operations surfaces this deployment actually operates, comma separated, or
# 'all'. Anything unlisted answers 404. Required in production; unset means the
# full surface, which is the development and CI behaviour.
# See docs/operations/admin-surface-enablement.md.
ADMIN_SURFACES=overview,attention,capabilities,approval-inbox,cases,disputes,money,search,users,organizations,jobs,provider-events,audit,analytics,account-recovery,privacy-requests,admin-changes,review-assignments,change-context,change-history,financial-reconciliation,team,metrics,diagnostics

# Optional dedicated read-only Prometheus credential, minimum 32 characters.
METRICS_SCRAPE_TOKEN=
