{
  "name": "kredit",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
	"audit": "node scripts/repository-audit.mjs && node scripts/product-contract-sync.mjs && node scripts/frontend-api-coverage.mjs && node --experimental-strip-types scripts/content-audit.mjs",
	"audit:contract-sync": "node scripts/product-contract-sync.mjs",
	"audit:frontend-api": "node scripts/frontend-api-coverage.mjs",
	"audit:content": "node --experimental-strip-types scripts/content-audit.mjs",
    "dev": "pnpm --dir web dev",
    "build": "pnpm --dir web build",
    "check": "pnpm --dir web check",
    "test": "pnpm --dir web test",
    "lint": "pnpm --dir web lint"
  },
  "devDependencies": {
    "openapi-typescript": "7.9.1"
  }
}
