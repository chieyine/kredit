{
    admin off
    servers {
        # Cloudflare publishes these ranges and changes them. A hardcoded list
        # goes stale silently: with trusted_proxies_strict, an unlisted range
        # stops being trusted, {client_ip} becomes Cloudflare's own address,
        # and every user behind that range collapses onto one rate-limit key -
        # locking them out of sign-in with nothing in the logs saying why.
        #
        # The ranges below are a fallback for a cold start only.
        # scripts/refresh-cloudflare-ranges.sh regenerates this file from
        # https://www.cloudflare.com/ips-v4 and ips-v6 and reloads Caddy; run
        # it from cron (weekly is ample) so the list cannot drift.
        #
        # BEGIN CLOUDFLARE RANGES (generated - do not edit by hand)
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        # END CLOUDFLARE RANGES
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

# Production API gateway behind Cloudflare
api.kredit.ng {
    # If using Cloudflare Origin CA certificate:
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

    # HTTP Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Proxy all traffic to the Go API container
    reverse_proxy api:8080 {
        header_up Host {host}
        header_up -CF-Connecting-IP
        header_up -True-Client-IP
        header_up -Forwarded
        # The API verifies the HMAC on these, so a forged set is already
        # rejected. Stripping them here means a forgery never reaches the
        # check at all, and the only signer is the frontend proxy.
        header_up -X-Kredit-Client-IP
        header_up -X-Kredit-Client-Timestamp
        header_up -X-Kredit-Client-Signature
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-Proto {scheme}

        transport http {
            response_header_timeout 30s
            dial_timeout 5s
        }
    }
}
