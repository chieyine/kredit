# Runtime-only settings for API/worker. Copy to .env.runtime.
# Complete provider settings using .env.example and the production guide.
# Core Application Settings
APP_ENV=production
APP_VERSION=1.0.0
ORIGIN=https://kredit.ng
PUBLIC_BASE_URL=https://kredit.ng
APP_BASE_URL=https://kredit.ng
API_INTERNAL_URL=https://api.kredit.ng
TIMEZONE=Africa/Lagos
CURRENCY=NGN
MONEY_UNIT=kobo

# Cryptographic Keys (Required 32-byte hex strings: openssl rand -hex 32)
SESSION_SIGNING_KEY=generate-with-openssl-rand-hex-32
FIELD_ENCRYPTION_KEY_ID=kredit-prod-v1
FIELD_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
OTP_HMAC_KEY=generate-with-openssl-rand-hex-32
TOKEN_HASH_KEY=generate-with-openssl-rand-hex-32
SETTINGS_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Cloudflare R2 Object Storage (S3-compatible)
# In Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
OBJECT_STORAGE_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=kredit-production
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=your-r2-access-key-id
OBJECT_STORAGE_SECRET_KEY=your-r2-secret-access-key

# Launch gates: enable only after attaching the real approvals.
FEATURE_PRODUCTION_PILOT=false
FEATURE_APPROVED_RETENTION_POLICY=false
PILOT_APPROVAL_REFERENCE=
RETENTION_APPROVAL_REFERENCE=
COLLECTION_PROVIDER=mono-sweep
IDENTITY_PROVIDER=

# Optional Notification Channels (Unconfigured channels fail safely)
FEATURE_WHATSAPP=false
# Native default, or connector for a Kredit connector v1 adapter.
NOTIFICATION_EMAIL_ADAPTER=
NOTIFICATION_EMAIL_ENDPOINT=
NOTIFICATION_EMAIL_FROM=
SENDLY_WEBHOOK_SECRET=
NOTIFICATION_EMAIL_TOKEN=
# Mesaj approved sender ID; HTTPS certificate verification is always enabled.
NOTIFICATION_SMS_FROM=
# Native default, or connector for a Kredit connector v1 adapter.
NOTIFICATION_SMS_ADAPTER=
NOTIFICATION_SMS_ENDPOINT=
NOTIFICATION_SMS_TOKEN=

# Private service configuration; never include maintenance database credentials.
ADMIN_SURFACES=all
OTEL_EXPORTER_OTLP_ENDPOINT=https://replace-with-your-collector.example
FRONTEND_PROXY_SIGNING_KEY=generate-with-openssl-rand-hex-32

# JSON connections for old providers; reconciliation only, never automatic debit fallback.
COLLECTION_RETAINED_PROVIDERS=
