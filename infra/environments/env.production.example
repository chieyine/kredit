# ==============================================================================
# Kredit Production Environment Configuration (kredit.ng)
# Copy this file to .env.production on the Cloudcone VPS.
# Generate 32-byte hex keys using: openssl rand -hex 32
# ==============================================================================

# Core Application Settings
APP_ENV=production
APP_VERSION=1.0.0
ORIGIN=https://kredit.ng
PUBLIC_BASE_URL=https://kredit.ng
APP_BASE_URL=https://kredit.ng
API_INTERNAL_URL=https://api.kredit.ng
TIMEZONE=Africa/Lagos
CURRENCY=NGN
MONEY_UNIT=kobo

# Database Passwords (used by docker-compose.prod.yml)
POSTGRES_ROOT_PASSWORD=replace-with-strong-db-root-password
KREDIT_APP_DB_PASSWORD=replace-with-strong-app-db-password
KREDIT_WORKER_DB_PASSWORD=replace-with-strong-worker-db-password
KREDIT_BACKUP_DB_PASSWORD=replace-with-strong-backup-db-password

# Cryptographic Keys (Required 32-byte hex strings: openssl rand -hex 32)
SESSION_SIGNING_KEY=generate-with-openssl-rand-hex-32
FIELD_ENCRYPTION_KEY_ID=kredit-prod-v1
FIELD_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
OTP_HMAC_KEY=generate-with-openssl-rand-hex-32
TOKEN_HASH_KEY=generate-with-openssl-rand-hex-32
SETTINGS_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Cloudflare R2 Object Storage (S3-compatible)
# In Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
OBJECT_STORAGE_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=kredit-production
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=your-r2-access-key-id
OBJECT_STORAGE_SECRET_KEY=your-r2-secret-access-key

# Live-Testing Pilot Mode (Behaves like production with simulated bank rails)
FEATURE_PRODUCTION_PILOT=true
FEATURE_APPROVED_RETENTION_POLICY=true
PILOT_APPROVAL_REFERENCE=internal-pilot-launch
RETENTION_APPROVAL_REFERENCE=internal-pilot-launch
COLLECTION_PROVIDER=mock-collection
IDENTITY_PROVIDER=mock-identity

# Optional Notification Channels (Unconfigured channels fail safely)
FEATURE_WHATSAPP=false
NOTIFICATION_EMAIL_ENDPOINT=
NOTIFICATION_EMAIL_TOKEN=
NOTIFICATION_SMS_ENDPOINT=
NOTIFICATION_SMS_TOKEN=

# Legal and Public Governance Details
LEGAL_DOCUMENTS_ACTIVE=true
LEGAL_ENTITY_NAME=Kredit Technologies Limited
LEGAL_SERVICE_ADDRESS="Lagos, Nigeria"
LEGAL_CONTACT_EMAIL=support@kredit.ng
PRIVACY_CONTACT_EMAIL=privacy@kredit.ng
LEGAL_EFFECTIVE_DATE=2026-09-11
TERMS_VERSION=supplier-terms-v1
PRIVACY_VERSION=privacy-v1
